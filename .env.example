# Firebase Web App Configuration (create a dedicated project, e.g. jerbz-hybrid-ai)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase App Check (required for Firebase AI Logic cloud calls)
# Option A (Free on Spark): reCAPTCHA v3 site key from https://www.google.com/recaptcha/admin/create
VITE_RECAPTCHA_V3_SITE_KEY=
# Option B: reCAPTCHA Enterprise site key
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional: Set to "true" on localhost to enable Firebase App Check debug token
VITE_APPCHECK_DEBUG=true

# Optional: Override Cloud Gemini fallback model (defaults to gemini-3.8-flash)
VITE_GEMINI_CLOUD_MODEL=gemini-3.8-flash
